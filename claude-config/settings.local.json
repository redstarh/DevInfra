      "WebFetch(domain:pubsonline.informs.org)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:papers.ssrn.com)",
      "WebFetch(domain:www.sciencedirect.com)",
      "WebFetch(domain:www.mdpi.com)",
      "WebFetch(domain:www.jmlr.org)",
      "WebFetch(domain:www.pm-research.com)",
      "WebFetch(domain:link.springer.com)",
      "Bash(grep -E \"\\\\.py$|state|data\")",
      "Bash(grep -E \"\\\\.\\(py|sql\\)$\")",
      "Bash(launchctl list *)",
      "Bash(./tools/neosa_stop.sh)",
      "Bash(echo \"exit=$?\")",
      "Bash(echo \"exit: $?\")",
      "Bash(bash -n tools/neosa_v015_check_account.sh)",
      "Bash(./tools/neosa_v015_check_account.sh)",
      "Bash(echo \"check exit=$?\")",
      "Read(//tmp/**)",
      "Bash(./tools/neosa_v015_check_account.sh --validate-state-store)",
      "Bash(bash -n /Users/redstar/AgentDev/research/quant-new/tools/neosa_v015_check_account.sh)",
      "Bash(shellcheck /Users/redstar/AgentDev/research/quant-new/tools/neosa_v015_check_account.sh)",
      "Bash(podman ps *)",
      "Bash(echo \"---PODMAN_EXIT:$?\")",
      "Bash(echo \"---DOCKER_EXIT:$?\")",
      "Bash(psql --version)",
      "Bash(nc -z localhost 5432)",
      "Bash(echo \"NC_EXIT:$?\")",
      "Bash(/Users/redstar/AgentDev/StockAgent/backend/.venv/bin/python *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
