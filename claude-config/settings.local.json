{
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(claude:*)",
      "Bash(python3:*)",
      "Bash(npm root:*)",
      "Bash(npm view:*)",
      "Bash(npm pack:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm start)",
      "Bash(npm install:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(tsc:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git commit -m ':*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
