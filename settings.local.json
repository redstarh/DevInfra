{
  "cleanupPeriodDays": 90,
  "env": {
    "DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(claude:*)",
      "Bash(omc update:*)",
      "Bash(omc --version:*)",
      "Bash(omc sync:*)",
      "Bash(python3:*)",
      "Bash(npm root:*)",
      "Bash(npm view:*)",
      "Bash(npm pack:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm start)",
      "Bash(npm install:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(tsc:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git reset:*)",
      "Bash(git commit -m ':*)",
      "Bash(git stash:*)",
      "Bash(git push:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/ruff format:*)",
      "Skill(generate-tests)",
      "mcp__plugin_oh-my-claudecode_t__lsp_diagnostics",
      "mcp__plugin_oh-my-claudecode_t__ast_grep_search",
      "mcp__plugin_oh-my-claudecode_t__lsp_servers",
      "mcp__plugin_oh-my-claudecode_t__state_list_active"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {}
}
